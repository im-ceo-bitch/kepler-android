<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/iumrah_widget_background" android:orientation="vertical"
    android:padding="16dp" android:gravity="center_vertical">
    <TextView android:id="@+id/widget_heading" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#B8C7EF" android:textSize="12sp" android:maxLines="1" />
    <TextView android:id="@+id/widget_main" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:textColor="#FFFFFF" android:textSize="27sp" android:textStyle="bold"
        android:ellipsize="end" android:maxLines="1" />
    <TextView android:id="@+id/widget_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="5dp" android:textColor="#F4D8C4" android:textSize="12sp"
        android:ellipsize="end" android:maxLines="2" />
    <TextView android:id="@+id/widget_brand" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:textColor="#FF7F45" android:textSize="11sp" android:textStyle="bold" />
</LinearLayout>
